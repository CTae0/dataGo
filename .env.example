# 복사해서 .env로 쓰세요. (.env는 git에 올리지 않습니다)
POSTGRES_DB=eodi
POSTGRES_USER=eodi
POSTGRES_PASSWORD=eodi_local
POSTGRES_PORT=5433

# 공공데이터포털 인증키 (전월세 실거래가 API용, 발급 후 입력)
DATA_GO_KR_SERVICE_KEY=

# V-World (vworld.kr) 인증키 — 시군구 경계용. 키를 발급할 때 등록한 서비스 URL을 domain으로 보내야 한다
VWORLD_API_KEY=
VWORLD_DOMAIN=localhost
